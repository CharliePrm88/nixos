#### =====================================================
#### ENV / PATH
#### =====================================================
####
#### JAVA_HOME e MAVEN_HOME sono stati rimossi: puntavano a
#### /usr/lib/jvm e /usr/share/java, percorsi FHS che su NixOS non
#### esistono. Il JDK arriva da programs.java (modules/programs/java.nix),
#### maven da environment.systemPackages: sono gia' nel PATH.
####
#### Anche il blocco XDG_* e' stato rimosso: lo imposta Home Manager
#### con xdg.enable (home/charlie/charlie.nix).
####
#### E cosi' il blocco ssh-agent: adesso lo gestisce
#### services.ssh-agent (home/charlie/programs/ssh.nix), che esporta
#### SSH_AUTH_SOCK da solo.

export M2_HOME="$HOME/.m2"
export PATH="$HOME/.local/bin:$PATH"

#### =====================================================
#### FORTUNE + COWSAY (solo shell interattiva)
#### =====================================================

if [[ -o interactive ]] \
   && command -v fortune >/dev/null 2>&1 \
   && command -v cowsay >/dev/null 2>&1 \
   && command -v lolcat  >/dev/null 2>&1; then

  COWS=($(cowsay -l | tail -n +2 | tr ' ' '\n'))
  COW=${COWS[RANDOM % ${#COWS[@]}]}

  fortune | cowsay -f "$COW" | lolcat -F 0.3
fi

#### =====================================================
#### PROMPT
#### =====================================================

# Spegne il prompt di grml. Starship viene inizializzato subito dopo da
# programs.starship.enableZshIntegration: l'eval che stava qui era un
# secondo init dello stesso prompt ed e' stato tolto.
prompt off
